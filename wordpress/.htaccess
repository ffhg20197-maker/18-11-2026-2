Options -Indexes
<FilesMatch "^(wp-config\.php|\.env|\.htaccess|\.htpasswd|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
<FilesMatch "(^\.|\.bak$|\.old$|\.orig$|\.save$|\.sql$|\.log$)">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>
# HTTPS redirect is kept in deploy/https-redirect.conf.example.
